# ──────────────────────────────────────────
#  iFinance API — variáveis de ambiente
#  Copie para .env e preencha com seus valores
# ──────────────────────────────────────────

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ifinance_dev
DB_USERNAME=ifinance
DB_PASSWORD=troque-esta-senha

# OAuth2 Google
# Obtenha em: https://console.cloud.google.com → APIs → Credenciais
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# OAuth2 GitHub (opcional — sem isso o login GitHub fica desativado)
# Crie um OAuth App em: https://github.com/settings/developers
# GITHUB_CLIENT_ID=seu-client-id
# GITHUB_CLIENT_SECRET=seu-client-secret

# E-mails promovidos a ADMIN no login (verificados no provedor), separados por vírgula
# APP_ADMIN_EMAILS=voce@exemplo.com

# Servidor (docker/prod)
SERVER_PORT=8080

# Imagem Docker (CI/CD — opcional localmente)
BACKEND_IMAGE=ghcr.io/dev-willem/ifinance-backend:latest

# ── Produção (perfil prod) ──
# Frontend roda em repo separado (github.com/dev-willem/ifinance), publicado na Vercel.
# GOOGLE_REDIRECT_URI=https://SEU-BACKEND/login/oauth2/code/google
# GITHUB_REDIRECT_URI=https://SEU-FRONTEND/login/oauth2/code/github
# APP_CORS_ALLOWED_ORIGINS=https://seu-projeto.vercel.app
# APP_FRONTEND_BASE_URL=https://seu-projeto.vercel.app
